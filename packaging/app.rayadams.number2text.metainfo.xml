<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.rayadams.number2text</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Number to Text converter</name>
  <summary>Number 2 Text is a free, open-source application to convert numbers to text</summary>

  <url type="homepage">https://github.com/XRayAdams/number2text-rs</url>

  <content_rating type="oars-1.1" />
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <description>
    <p>Number 2 Text is a free, open-source utility designed for the quick and accurate conversion
      of numerical values into their textual representation</p>

    <p>Supported Languages</p>

    <ul>
      <li>English</li>
      <li>Spanish</li>
      <li>German</li>
      <li>French</li>
      <li>Russian</li>
      <li>Italian</li>
      <li>Portuguese</li>
    </ul>
  </description>

  <releases>
    <release version="2.2.2+32" date="2026-03-04" />
  </releases>

  <launchable type="desktop-id">app.rayadams.number2text.desktop</launchable>
  <developer id="app.rayadams">
    <name translate="no">Konstantin Adamov</name>
  </developer>

  <screenshots>
    <screenshot type="default">
      <image type="source">https://raw.githubusercontent.com/XRayAdams/number2text-rs/refs/heads/master/screenshots/screenshot01.png</image>
      <caption>Main window</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/XRayAdams/number2text-rs/refs/heads/master/screenshots/screenshot02.png</image>
      <caption>Number conversion example</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/XRayAdams/number2text-rs/refs/heads/master/screenshots/screenshot03.png</image>
      <caption>Language selection</caption>
    </screenshot>
  </screenshots>
</component>